        <action id="MockDataSwitchEnvAction"
                class="com.alipay.devtools.mockdata.actions.MockDataSwitchEnvAction"
                text="MockData: Switch Env"
                description="Switch MockData environment">
            <add-to-group group-id="MainToolbarLeft" anchor="last"/>
        </action>
        <action id="MockDataEnvTagLabel"
                class="com.alipay.devtools.mockdata.actions.MockDataEnvTagLabel"
                text="MockData ENV Label"
                description="只读 JBLabel 样式 tag">
            <add-to-group group-id="MainToolbarLeft" anchor="after" relative-to-action="MockDataSwitchEnvAction"/>
        </action>
